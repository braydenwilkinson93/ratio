generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PollStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ArgumentSide {
  FOR
  AGAINST
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  displayName  String
  bio          String?    @db.VarChar(280)
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  polls        Poll[]     @relation("PollCreator")
  votes        Vote[]
  arguments    Argument[]
  rebuttals    Rebuttal[]

  @@index([createdAt])
}

model Poll {
  id          String      @id @default(cuid())
  slug        String      @unique
  question    String      @db.VarChar(240)
  description String      @db.Text
  category    String      @db.VarChar(80)
  status      PollStatus  @default(PUBLISHED)
  closesAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  creatorId   String
  creator     User        @relation("PollCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       Vote[]
  arguments   Argument[]

  @@index([status, createdAt])
  @@index([creatorId])
}

model PollOption {
  id        String @id @default(cuid())
  label     String @db.VarChar(120)
  position  Int
  pollId    String
  poll      Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@unique([pollId, position])
  @@index([pollId])
}

model Vote {
  id          String     @id @default(cuid())
  round       Int        @default(1)
  confidence  Int
  createdAt   DateTime   @default(now())
  userId      String
  pollId      String
  optionId    String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId, round])
  @@index([pollId, round])
  @@index([optionId])
}

model Argument {
  id        String       @id @default(cuid())
  title     String       @db.VarChar(140)
  summary   String       @db.VarChar(500)
  side      ArgumentSide
  score     Int          @default(0)
  approved  Boolean      @default(true)
  createdAt DateTime     @default(now())
  authorId  String
  pollId    String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  poll      Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  rebuttals Rebuttal[]

  @@index([pollId, side, approved])
}

model Rebuttal {
  id         String   @id @default(cuid())
  body       String   @db.VarChar(500)
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())
  authorId   String
  argumentId String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  argument   Argument @relation(fields: [argumentId], references: [id], onDelete: Cascade)

  @@index([argumentId, approved])
}

model RateLimit {
  id          String   @id @default(cuid())
  keyHash     String
  action      String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([keyHash, action, windowStart])
  @@index([windowStart])
}
